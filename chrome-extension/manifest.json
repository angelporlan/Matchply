{
  "manifest_version": 3,
  "name": "Matchply LinkedIn Capture",
  "version": "2.3.14",
  "homepage_url": "https://matchply.com",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "description": "Captura ofertas en LinkedIn y las env\u00eda a tu cuenta de Matchply.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://matchply.com/*",
    "https://*.licdn.com/*",
    "https://*.linkedin.com/*",
    "https://linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": [
        "people.js",
        "job-list.js",
        "public-description.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Matchply LinkedIn Capture",
    "default_popup": "popup.html"
  }
}
