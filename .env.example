# Entorno
NODE_ENV=development
PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=genera_un_hash_seguro_de_32_caracteres
AUTH_TRUST_HOST=true

# Base de Datos (Interna Docker & Externa TablePlus)
# Conexión interna de Docker usa el host "db"
DATABASE_URL=postgresql://postgres:nextprof_secure_pwd@db:5432/nextprof_db
# Conexión externa para tu Mac (TablePlus): postgresql://postgres:nextprof_secure_pwd@localhost:5432/nextprof_db

# Stripe Configuration
STRIPE_MODE=test # 'test' o 'production'

# Stripe Test Keys
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TEST_WEBHOOK_SECRET=whsec_...
STRIPE_TEST_PRICE_ID_PRO=price_...

# Stripe Production Keys
STRIPE_PROD_SECRET_KEY=sk_live_...
STRIPE_PROD_WEBHOOK_SECRET=whsec_...
STRIPE_PROD_PRICE_ID_PRO=price_...

# URL webhook Stripe: https://tudominio.com/api/stripe/webhook (o http://localhost:3000/api/stripe/webhook en local)
# Eventos recomendados: checkout.session.completed, invoice.payment_succeeded,
# customer.subscription.updated, customer.subscription.deleted

# Inteligencia Artificial
OPENROUTER_API_KEY=sk-or-v1-...
DEEPSEEK_API_KEY=sk-...
GEMINI_API_KEY=AIzaSy...
# Solo para desarrollo: si falta una API key, usa CVs simulados en lugar de fallar
# ALLOW_AI_MOCK=true
PREFERRED_PRO_PROVIDER=deepseek # 'deepseek' o 'gemini'

# Google OAuth
GOOGLE_CLIENT_ID=tu_client_id_de_google.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret_de_google

# Investigación profunda de ofertas de LinkedIn
TAVILY_API_KEY=tvly-...
RESEARCH_PIPELINE_ENABLED=false
RESEARCH_GLOBAL_CONCURRENCY=2
RESEARCH_MONTHLY_QUOTA=10
AI_PROMPTS_DEBUG=true # Para depurar los prompts

# Pool Postgres y timeouts (web ~15s, workers ~180s)
DATABASE_POOL_MAX=8
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Cola de jobs de IA (worker `ai:worker`)
AI_GLOBAL_CONCURRENCY=2
AI_WORKER_ENABLED=true

# Render PDF fuera del event loop (1-2 hilos en el proceso web)
PDF_WORKER_POOL_SIZE=2
# PDF_WORKER_TIMEOUT_MS=30000
# PDF_CACHE_MAX_ENTRIES=64
# PDF_CACHE_TTL_MS=1800000

# Impersonación de soporte (desactivada por defecto)
# IMPERSONATION_ENABLED=true

# Umami (medición agregada; desactivada hasta UMAMI_AEPD_CLEARED=true)
# UMAMI_ENABLED=true
# UMAMI_AEPD_CLEARED=false
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://matchply.com/umami/script.js
# UMAMI_API_URL=http://127.0.0.1:3001
# UMAMI_API_TOKEN=
# UMAMI_WEBSITE_ID=
# UMAMI_DB_PASSWORD=
# UMAMI_APP_SECRET=
